{
  "name": "periferia-reto",
  "version": "1.0.0",
  "description": "Agente conversacional con herramientas tipadas (zod) y confirmación humana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "demo": "tsx demo.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:modulo": "tsx scripts/build-modulo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
