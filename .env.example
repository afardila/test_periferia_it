# Copia a .env (o configura estas variables en el hosting). Nunca subas valores reales.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
PORT=3000
# Carpeta de fixtures (relativa a la raíz del proyecto)
FIXTURES_DIR=fixtures/reto-02
FECHA_CORTE=2026-05-30
# Clave de acceso a la app (usuario libre). Defínela SIEMPRE en el despliegue público
APP_PASSWORD=
RATE_LIMIT_PER_MIN=60
# Topes de costo: iteraciones herramienta→modelo por turno y tokens por sesión
MAX_ITER=25
MAX_SESSION_TOKENS=300000
LLM_TIMEOUT_MS=60000
