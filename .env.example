# Copia a .env (o configura estas variables en el hosting)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo: cámbialo si necesitas otro (más barato = claude-haiku-5-5, más capaz = claude-sonnet-5-5)
MODEL=claude-sonnet-5-5
PORT=3000
# Carpeta con los fixtures del reto (el día de la prueba apunta a la carpeta descomprimida)
FIXTURES_DIR=./fixtures-demo
# Fecha de corte del maestro (el reto lo congela al 30 de mayo de 2026)
FECHA_CORTE=2026-05-30
# Clave de acceso a la app (usuario libre). Defínela SIEMPRE en el despliegue público
APP_PASSWORD=cambia-esta-clave
RATE_LIMIT_PER_MIN=60
